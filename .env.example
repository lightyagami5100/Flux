# Flux configuration. Copy to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# --- Runtime -----------------------------------------------------------------
# development | production
# Anything other than development/dev/test/local makes the settings below
# mandatory: the app refuses to start on defaults (app/config.py).
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Device auth -------------------------------------------------------------
# JSON object mapping api_key -> device_id. Sent as the X-API-Key header.
# Empty means every ingest request is rejected with 401.
API_KEYS='{"dev-key-camera-1": "cam-01"}'

# --- Postgres / PostGIS ------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://flux:flux@localhost:5432/flux
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Dev convenience: create tables on boot. Must be false in production.
AUTO_CREATE_TABLES=true

# Used by infra/docker-compose*.yml to provision the db container.
POSTGRES_USER=flux
POSTGRES_PASSWORD=
POSTGRES_DB=flux

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
INGEST_STREAM=stream:detections
INGEST_CONSUMER_GROUP=detection-workers
STREAM_MAXLEN=1000000

# --- Object storage (MinIO / S3-compatible) ----------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=media
MINIO_SECURE=false

# --- External CV inference ---------------------------------------------------
# Inference is remote only. No local weights, no local GPU.
PROCESSOR_NAME=roboflow
ROBOFLOW_API_KEY=
# Roboflow project/version, e.g. my-pothole-project/4. The built-in default
# (coco/3) has no pothole class and is rejected in production.
ROBOFLOW_MODEL_ID=

# Video is sampled, not decoded whole: inference is billed per frame.
VIDEO_SAMPLE_EVERY_N_FRAMES=15
VIDEO_MAX_FRAMES=20

# --- Ingest limits -----------------------------------------------------------
IDEMPOTENCY_TTL_SECONDS=86400
MAX_BODY_BYTES=262144
