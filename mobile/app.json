{
  "expo": {
    "name": "Flux Patrol",
    "slug": "flux-patrol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flux-patrol",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flux.patrol",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Flux Patrol needs camera access to record road conditions for pothole detection.",
        "NSLocationWhenInUseUsageDescription": "Flux Patrol needs your location to geo-tag road condition reports.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Flux Patrol needs continuous location access to track your patrol route and auto-detect road conditions.",
        "NSMicrophoneUsageDescription": "Flux Patrol needs microphone access to record audio with road condition videos."
      }
    },
    "android": {
      "package": "com.flux.patrol",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A84FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "INTERNET",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A84FF",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Flux Patrol needs camera access to record road conditions."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Flux Patrol needs location access to geo-tag road condition reports."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
